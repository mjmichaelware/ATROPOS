FROM python:3.11-slim@sha256:baf89808ec37adeaab83cec287adb4a2afa4a11c1d51e961c7ec737877e61af6 AS base
LABEL org.opencontainers.image.source="https://github.com/mjmichaelware/specgraph-foundry"
LABEL org.opencontainers.image.description="SpecGraph Foundry API server"
LABEL com.specgraph.component="api"

RUN addgroup --system --gid 1001 specgraph && \
    adduser --system --uid 1001 --gid 1001 --no-create-home specgraph

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ src/
COPY scripts/check_licenses.py scripts/
COPY LICENSES/ LICENSES/
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md ./

RUN pip install --no-cache-dir -e ".[postgres]" 2>&1 | tail -5

RUN python -m compileall -q src scripts

RUN rm -rf /root/.cache/pip

USER specgraph
EXPOSE 8080
ENV PORT=8080
ENV SPECGRAPH_LOG_FORMAT=json

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import http.client; c=http.client.HTTPConnection('127.0.0.1', 8080); c.request('GET','/health'); r=c.getresponse(); assert r.status==200, f'health failed: {r.status}'; r.read()" || exit 1

ENTRYPOINT ["python", "-m", "specgraph_foundry.http_api"]
