{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd apps/web && npm ci && npm run build",
  "outputDirectory": "apps/web/.next",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": true
  },
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}
