{
  "name": "@atropos/web",
  "version": "1.0.0",
  "description": "ATROPOS unified web application - OpenCode-class workflow with integrated SpecGraph",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "build:termux": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "api:types": "openapi-typescript ../../openapi/specgraph-v1.yaml --output src/lib/api/generated.ts",
    "api:types:check": "tmp=$(mktemp) && openapi-typescript ../../openapi/specgraph-v1.yaml --output \"$tmp\" && diff -u src/lib/api/generated.ts \"$tmp\"; status=$?; rm -f \"$tmp\"; exit $status",
    "check": "npm run api:types:check && npm run typecheck && npm run lint && npm test && npm run build:termux"
  },
  "dependencies": {
    "@atropos/design-tokens": "file:../../packages/design-tokens",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tooltip": "1.2.12",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.0",
    "@tanstack/react-query": "5.101.2",
    "@xyflow/react": "12.11.2",
    "clsx": "2.1.1",
    "elkjs": "0.11.1",
    "lucide-react": "1.27.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "sharp": "0.35.3",
    "postcss": "8.5.21",
    "minimatch": "10.2.5"
  }
}
