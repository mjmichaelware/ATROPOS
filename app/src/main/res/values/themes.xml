<?xml version="1.0" encoding="utf-8"?>
<!--
  A Compose activity still needs a platform theme for the window itself: the
  system draws the status bar, background and splash before any composable
  runs. NoActionBar because the app draws its own header, and the manifest can
  no longer reference @android:style/Theme.DeviceDefault.Light.NoActionBar now
  that the activity hosts Compose and must not get an action bar from the
  platform.
-->
<resources>
    <style name="Theme.Atropos" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/background_light</item>
    </style>
</resources>
