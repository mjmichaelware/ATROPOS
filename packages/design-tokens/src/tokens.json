{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "metadata": {
    "name": "ATROPOS Design Tokens",
    "description": "Shared design tokens for ATROPOS web, CLI, and mobile",
    "primaryColor": "red",
    "version": "1.0.0",
    "author": "ATROPOS Design System",
    "note": "All tokens prefixed with --sg- (SpecGraph/ATROPOS standard). Primary theme color is RED."
  },
  "colors": {
    "red": {
      "50": "#fef2f2",
      "100": "#fee2e2",
      "200": "#fecaca",
      "300": "#fca5a5",
      "400": "#f87171",
      "500": "#ef4444",
      "600": "#dc2626",
      "700": "#b91c1c",
      "800": "#991b1b",
      "900": "#7f1d1d",
      "950": "#4c0519"
    },
    "gray": {
      "50": "#f9fafb",
      "100": "#f3f4f6",
      "200": "#e5e7eb",
      "300": "#d1d5db",
      "400": "#9ca3af",
      "500": "#6b7280",
      "600": "#4b5563",
      "700": "#374151",
      "800": "#1f2937",
      "900": "#111827",
      "950": "#030712"
    },
    "green": {
      "50": "#f0fdf4",
      "100": "#dcfce7",
      "200": "#bbf7d0",
      "300": "#86efac",
      "400": "#4ade80",
      "500": "#22c55e",
      "600": "#16a34a",
      "700": "#15803d",
      "800": "#166534",
      "900": "#145231"
    },
    "amber": {
      "50": "#fffbeb",
      "100": "#fef3c7",
      "200": "#fde68a",
      "300": "#fcd34d",
      "400": "#fbbf24",
      "500": "#f59e0b",
      "600": "#d97706",
      "700": "#b45309",
      "800": "#92400e",
      "900": "#78350f"
    },
    "blue": {
      "50": "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "400": "#60a5fa",
      "500": "#3b82f6",
      "600": "#2563eb",
      "700": "#1d4ed8",
      "800": "#1e40af",
      "900": "#1e3a8a"
    },
    "cyan": {
      "50": "#ecf9ff",
      "100": "#d3f0ff",
      "200": "#a8e0ff",
      "300": "#77cbff",
      "400": "#4fb0ff",
      "500": "#0096ff",
      "600": "#0078d4",
      "700": "#0063b1",
      "800": "#004b87",
      "900": "#003d6b"
    }
  },
  "semantic": {
    "surface": {
      "canvas": {
        "light": "{colors.gray.50}",
        "dark": "{colors.gray.950}"
      },
      "elevated": {
        "light": "{colors.gray.0}",
        "dark": "{colors.gray.900}"
      },
      "overlay": {
        "light": "{colors.gray.100}",
        "dark": "{colors.gray.800}"
      }
    },
    "text": {
      "primary": {
        "light": "{colors.gray.950}",
        "dark": "{colors.gray.50}"
      },
      "secondary": {
        "light": "{colors.gray.600}",
        "dark": "{colors.gray.400}"
      },
      "muted": {
        "light": "{colors.gray.500}",
        "dark": "{colors.gray.500}"
      },
      "inverse": {
        "light": "{colors.gray.50}",
        "dark": "{colors.gray.950}"
      }
    },
    "border": {
      "light": "{colors.gray.200}",
      "dark": "{colors.gray.700}"
    },
    "brand": {
      "primary": "{colors.red.600}",
      "primaryLight": "{colors.red.400}",
      "primaryDark": "{colors.red.800}",
      "hover": "{colors.red.700}",
      "active": "{colors.red.900}",
      "muted": "{colors.red.100}",
      "mutedDark": "{colors.red.900}"
    },
    "status": {
      "success": "{colors.green.600}",
      "warning": "{colors.amber.600}",
      "danger": "{colors.red.600}",
      "info": "{colors.blue.600}",
      "pending": "{colors.gray.500}"
    },
    "domain": {
      "source": "{colors.cyan.500}",
      "research": "{colors.amber.500}",
      "planning": "{colors.blue.500}",
      "verified": "{colors.green.600}",
      "blocked": "{colors.red.600}",
      "unknown": "{colors.gray.500}"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem",
    "40": "10rem",
    "48": "12rem",
    "56": "14rem",
    "64": "16rem"
  },
  "sizing": {
    "full": "100%",
    "screen": "100vw",
    "screenHeight": "100vh",
    "min": "min-content",
    "max": "max-content",
    "fit": "fit-content"
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif",
      "mono": "'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "lineHeight": {
      "none": "1",
      "tight": "1.25",
      "snug": "1.375",
      "normal": "1.5",
      "relaxed": "1.625",
      "loose": "2"
    },
    "fontWeight": {
      "thin": "100",
      "extralight": "200",
      "light": "300",
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800",
      "black": "900"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "normal": "200ms",
      "slow": "300ms",
      "reveal": "500ms",
      "morph": "700ms",
      "press": "50ms"
    },
    "easing": {
      "ease": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "easeIn": "cubic-bezier(0.42, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.58, 1)",
      "easeInOut": "cubic-bezier(0.42, 0, 0.58, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "linear": "linear"
    }
  },
  "radii": {
    "none": "0",
    "sm": "0.125rem",
    "base": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px"
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
    "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
    "inner": "inset 0 2px 4px 0 rgba(0, 0, 0, 0.05)"
  },
  "zIndex": {
    "hide": "-1",
    "base": "0",
    "docked": "10",
    "sticky": "20",
    "fixed": "30",
    "backdrop": "40",
    "offscreen": "50",
    "modal": "60",
    "popover": "70",
    "skipLink": "80",
    "toast": "90",
    "tooltip": "100"
  },
  "breakpoints": {
    "xs": "0px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}
