{
  "name": "@atropos/design-tokens",
  "version": "1.0.0",
  "description": "ATROPOS shared design tokens - RED theme for web, CLI, and mobile surfaces",
  "main": "./src/index.ts",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "default": "./src/tokens.json"
    },
    "./theme": {
      "types": "./src/customization/runtimeThemeMixin.ts",
      "import": "./src/customization/runtimeThemeMixin.ts",
      "default": "./src/customization/runtimeThemeMixin.ts"
    },
    "./web": {
      "style": "./src/web/tokens.css",
      "import": "./src/web/tokens.css",
      "default": "./src/web/tokens.css"
    },
    "./web/themes": {
      "style": "./src/web/themes.css",
      "import": "./src/web/themes.css",
      "default": "./src/web/themes.css"
    },
    "./cli": {
      "default": "./src/cli/DesignTokens.kt"
    }
  },
  "scripts": {
    "generate": "node build/scripts/generate-tokens.js",
    "generate:watch": "nodemon --watch src/tokens.json --exec 'npm run generate'",
    "build": "npm run generate",
    "dev": "npm run generate:watch"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "atropos",
    "red-theme",
    "css-variables",
    "typescript"
  ],
  "author": "ATROPOS",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}